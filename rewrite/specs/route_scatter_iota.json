{
  "grid": ["=ceil_div(N,1024)", 1, 1],
  "block": [256, 1, 1],
  "buffers": {
    "ids": {"bytes": "=N*4", "fill": {"kind": "rand", "dtype": "i32", "seed": "=SEED", "lo": -3, "hi": 600}},
    "boff": {"bytes": "=ceil_div(N,1024)*2048", "fill": {"kind": "iota", "dtype": "i32", "start": 0, "step": 4096}},
    "rank": {"bytes": "=(N+256)*4", "fill": {"kind": "iota", "dtype": "i32", "start": 0, "step": 1}},
    "perm": {"bytes": "=ceil_div(N,1024)*512*4096*4", "fill": {"kind": "const", "dtype": "i32", "value": -7}},
    "slot": {"bytes": "=(N+256)*4", "fill": {"kind": "const", "dtype": "i32", "value": -7}}
  },
  "args": [
    {"offset": 0, "buffer": "ids"},
    {"offset": 8, "type": "i32", "value": "=N"},
    {"offset": 16, "buffer": "boff"},
    {"offset": 24, "buffer": "rank"},
    {"offset": 32, "buffer": "perm"},
    {"offset": 40, "buffer": "slot"}
  ],
  "dump": ["perm", "slot"],
  "compare": {
    "rewrite_src": "../kernels/route_scatter.hip",
    "rewrite_kernel": "k_route_scatter",
    "outputs": [{"buffer": "perm", "dtype": "i32"}, {"buffer": "slot", "dtype": "i32"}]
  }
}
