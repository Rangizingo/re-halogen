{
  "grid": ["=ceil_div(20*N,256)", 1, 1],
  "block": [256, 1, 1],
  "buffers": {
    "ids": {"bytes": "=N*4", "fill": {"kind": "rand", "dtype": "i32", "seed": "=SEED", "lo": 0, "hi": 256}},
    "A": {"bytes": "=N*5*16+64", "fill": {"kind": "const", "dtype": "i32", "value": -1}},
    "B": {"bytes": "=N*20*16+64", "fill": {"kind": "const", "dtype": "i32", "value": -1}},
    "tok": {"bytes": "=N*4+64", "fill": {"kind": "const", "dtype": "i32", "value": -1}},
    "rank": {"bytes": "=N*4+64", "fill": {"kind": "const", "dtype": "i32", "value": -1}}
  },
  "args": [
    {"offset": 0, "buffer": "ids"},
    {"offset": 8, "type": "i32", "value": "=N"},
    {"offset": 16, "buffer": "A"},
    {"offset": 24, "buffer": "B"},
    {"offset": 32, "buffer": "tok"},
    {"offset": 40, "buffer": "rank"}
  ],
  "dump": ["A", "B", "tok", "rank"],
  "compare": {
    "rewrite_src": "../kernels/ht_items.hip",
    "rewrite_kernel": "k_ht_items_slots",
    "outputs": [
      {"buffer": "A", "dtype": "i32"},
      {"buffer": "B", "dtype": "i32"},
      {"buffer": "tok", "dtype": "i32"},
      {"buffer": "rank", "dtype": "i32"}
    ]
  }
}
